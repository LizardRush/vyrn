# Fails if torch/ATen headers are included by the Qt app or the CLI, or if the core's public headers
# include Qt or torch. (Qt's `slots` macro breaks libtorch headers; the GUI must stay torch-free.)
# Usage: cmake -DSRC=<source dir> -P lint_headers.cmake
set(errors "")
file(GLOB_RECURSE app_files "${SRC}/app/*.cpp" "${SRC}/app/*.h" "${SRC}/cli/*.cpp" "${SRC}/cli/*.h")
foreach(f IN LISTS app_files)
  file(STRINGS "${f}" hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"](torch/|ATen/|c10/|caffe2/)")
  if(hits)
    string(APPEND errors "${f} includes torch headers: ${hits}\n")
  endif()
endforeach()
file(GLOB public_headers "${SRC}/core/include/vyrn/*.h")
foreach(f IN LISTS public_headers)
  file(STRINGS "${f}" hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"](torch/|ATen/|c10/|Q[A-Za-z]+|Qsci/|nlohmann/)")
  if(hits)
    string(APPEND errors "${f} (public header) includes non-standard headers: ${hits}\n")
  endif()
endforeach()
if(errors)
  message(FATAL_ERROR "Header lint failed:\n${errors}")
endif()
message(STATUS "Header lint ok")
