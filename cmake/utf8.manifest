<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows: run with UTF-8 as the process's ANSI code page (Windows 10 1903+), so narrow strings (paths, getenv,
     std::filesystem::path from std::string) are UTF-8 like on Linux and macOS (docs/dev/platforms.md section 3). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
